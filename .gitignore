# 2B-Engram-AttnRes .gitignore

# Root-level ignore by default
/*
!/train/
!/docs/
!/data_pipeline/
!/AGENTS.md
!/pytest.ini
!/README.md
!/.gitignore

# Large binaries, models, and checkpoints (move via HF / storage)
OriginalModel/
QuantizedModel/
LlamaCPPBinaries/
ReferenceCode/
exports/
*.pt
*.safetensors
*.gguf
*.bin
*.npy
*.npz
*.tar*
*.zip

# Training outputs & logs
train/runs/*
!train/runs/README.md
train/data/bulk_npz/*
!train/data/bulk_npz/README.md
train/data/shards/*
!train/data/shards/README.md
*.log
common.log

# Data pipeline downloaded corpora & bulk outputs
data_pipeline/DownloadedData/
data_pipeline/bulk_out/
data_pipeline/bulk_out_test/
data_pipeline/shards/
data_pipeline/shards.dryrun/
data_pipeline/formatted.dryrun/
data_pipeline/raw.dryrun/
data_pipeline/raw_inspect/
data_pipeline/*.jsonl
data_pipeline/*.npz
data_pipeline/*.npy

# Python caches & virtual environments
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Dev Ops & Remote Machine Management (off-git)
.remote_box.json
ops/
